// data.src — tasks live behind a tiny backend seam.
//
// Primary: the suite-managed local bkn (HTTP store API). Endpoint resolves
// from $MDK_TASKS_BKN_URL (+$MDK_TASKS_BKN_TOKEN), else
// $MACHIN_365_HOME/config.json local_port/local_token, defaulting to
// ~/.local/share/machin-365/config.json when the var is unset. Probed once at first
// use via /_health; the choice is sticky for the session so data never
// silently splits across backends — start `machin-365 service start`
// BEFORE launching the app to get bkn mode.
//
// Fallback: SQLite at $MDK_TASKS_DB > $MACHIN_365_HOME/data/tasks/tasks.db >
// ~/.local/share/mdk-tasks/tasks.db. Force either with
// $MDK_TASKS_BACKEND=bkn|sqlite.
//
// bkn mode caches the collection in memory and re-polls every 5s, so
// `machin-365 sync` changes appear without restart. Every write sets
// _mtime (ms) — that is the field suite sync uses for last-writer-wins.
// Deletes propagate through sync/tombstones: bkn_del writes the tombstone
// BEFORE the DELETE, and only mutates g_tasks when both land.
//
// Writes are honest: a failed bkn call never touches g_tasks, the reason
// is kept in g_bkn_err for the UI badge (sync_error), and consecutive
// failures trigger a /_health re-probe so a restarted bkn is picked up
// without an app restart. While on the sqlite fallback an unforced
// backend re-probes every 60s and folds pending local tasks into bkn
// when it comes up, so data never silently splits across backends.

type Task struct { id string  title string  done int  created int }
type BknCfg struct { local_port int  local_token string }

var g_backend = 0        // 0 unknown, 1 bkn, 2 sqlite
var g_backend_forced = 0 // MDK_TASKS_BACKEND was set
var g_bkn_url = ""
var g_bkn_tok = ""
var g_tasks = []Task{}
var g_poll = 0
var g_bkn_err = ""       // why the last bkn call failed ("" = healthy)
var g_bkn_err_at = 0     // now_ms() of that failure
var g_bkn_fails = 0      // consecutive bkn call failures
var g_reprobe_at = 0     // last mid-session backend re-probe

func jstr(j, path) {
    v, e := json_get(j, path)
    if e != "" { return "" }
    return parse(v, "")
}

func jint(j, path) {
    v, e := json_get(j, path)
    if e != "" { return 0 }
    return parse_int(trim(v))
}

func task_from_json(r) (t) {
    t = Task{id: jstr(r, ".id"), title: jstr(r, ".title"),
        done: jint(r, ".done"), created: jint(r, ".created")}
    return t
}

// --- backend selection -------------------------------------------------

func bkn_endpoint() {
    u := env("MDK_TASKS_BKN_URL")
    if u != "" {
        g_bkn_url = u
        g_bkn_tok = env("MDK_TASKS_BKN_TOKEN")
        return u
    }
    h := env("MACHIN_365_HOME")
    if h == "" { h = env("HOME") + "/.local/share/machin-365" }
    s := read_file(h + "/config.json")
    if s == "" { return "" }
    c := parse(s, BknCfg{})
    if c.local_port == 0 || c.local_token == "" { return "" }
    g_bkn_url = "http://127.0.0.1:" + str(c.local_port)
    g_bkn_tok = c.local_token
    return g_bkn_url
}

func probe() {
    if g_backend != 0 { return }
    forced := env("MDK_TASKS_BACKEND")
    if forced != "" { g_backend_forced = 1 }
    if forced == "sqlite" { g_backend = 2  return }
    if forced == "bkn" { g_backend = 1  g_bkn_url = bkn_endpoint()  return }
    u := bkn_endpoint()
    if u == "" { g_backend = 2  return }
    st, _, _ := http_get(u + "/_health")
    if st == 200 { g_backend = 1 } else { g_backend = 2 }
}

// --- bkn http ------------------------------------------------------------

// one bkn call -> (status, body, err). err=="" means a 2xx response
// arrived; anything else — transport failure or non-2xx — comes back with
// err set ("connect"/"dns"/... or "http <st>") and st 0 on transport
// errors. Failures feed the counter behind sync_error() and trigger the
// mid-session re-probe, so a dead bkn is visible instead of silent.
func bkn_req(method, path, body) {
    st, resp, err := http_request(method, g_bkn_url + path,
        []string{"Authorization: Bearer " + g_bkn_tok, "Content-Type: application/json"}, body)
    if err == "" && st >= 200 && st < 300 {
        g_bkn_fails = 0
        g_bkn_err = ""
    } else {
        if err == "" { err = "http " + str(st) }
        g_bkn_fails = g_bkn_fails + 1
        g_bkn_err = err
        g_bkn_err_at = now_ms()
        bkn_health_probe()
    }
    return st, resp, err
}

// while bkn keeps failing, re-check /_health every 30s so a service that
// was restarted mid-session is noticed without an app restart; a healthy
// answer resets the failure streak early (the next real call clears the
// error badge itself).
func bkn_health_probe() {
    if g_bkn_fails < 4 { return }
    if now_ms() - g_reprobe_at < 30000 { return }
    g_reprobe_at = now_ms()
    pst, _, _ := http_get(g_bkn_url + "/_health")
    if pst == 200 { g_bkn_fails = 0 }
}

// bkn paginates at `limit` — walk offset until a short page or the list is
// silently truncated at 500 (same loop as sync's fetch_records). g_tasks is
// only swapped in after the LAST page lands, so a mid-fetch failure keeps
// the previous full snapshot instead of a partial one. The page cap keeps a
// server that ignores offset from spinning this inside the frame loop.
func bkn_refresh() {
    ts := []Task{}
    off := 0
    pages := 0
    while pages < 100 {
        st, body, err := bkn_req("GET", "/v1/store/m365/tasks?limit=500&offset=" + str(off), "")
        if err != "" || st != 200 || body == "" { return }
        n := 0
        i := 0
        while true {
            r, e := json_get(body, ".records[" + str(i) + "]")
            if e != "" { break }
            ts = append(ts, task_from_json(r))
            i = i + 1
            n = n + 1
        }
        if n < 500 { break }
        off = off + 500
        pages = pages + 1
    }
    g_tasks = sort_tasks(ts)
}

func sort_tasks(ts) {
    // active first (done=0), then newest created — mirrors old SQL ORDER BY
    i := 1
    while i < len(ts) {
        t := ts[i]
        j := i
        while j > 0 && (ts[j-1].done > t.done ||
            (ts[j-1].done == t.done && ts[j-1].created < t.created)) {
            ts[j] = ts[j-1]
            j = j - 1
        }
        ts[j] = t
        i = i + 1
    }
    return ts
}

// returns 1 when the task was created in bkn; 0 leaves g_tasks untouched
// and the failure shows up via sync_error()
func bkn_add(title, now) (ok) {
    ok = 0
    body := "{\"title\":" + json(title) + ",\"done\":0,\"created\":" +
        str(now) + ",\"_mtime\":" + str(now) + "}"
    _, resp, err := bkn_req("POST", "/v1/store/m365/tasks", body)
    if err != "" { return ok }
    id := jstr(resp, ".record.id")
    if id == "" {
        g_bkn_err = "POST /v1/store/m365/tasks: no record.id in response"
        g_bkn_err_at = now_ms()
        return ok
    }
    g_tasks = append(g_tasks, Task{id: id, title: title, done: 0, created: now})
    g_tasks = sort_tasks(g_tasks)
    ok = 1
    return ok
}

func bkn_set_done(id, nd, now) {
    _, _, err := bkn_req("PATCH", "/v1/store/m365/tasks/" + id,
        "{\"done\":" + str(nd) + ",\"_mtime\":" + str(now) + "}")
    if err != "" { return }
    i := 0
    while i < len(g_tasks) {
        if g_tasks[i].id == id {
            g_tasks[i].done = nd
            break
        }
        i = i + 1
    }
    g_tasks = sort_tasks(g_tasks)
}

func bkn_del(id) {
    // tombstone first so suite sync propagates the delete instead of
    // resurrecting the record on the next pass; if it fails, keep the
    // task so the delete can be retried — deleting without it is how
    // records came back
    now := now_ms()
    _, _, err := bkn_req("POST", "/v1/store/sync/tombstones",
        "{\"ref\":\"m365/tasks\",\"id\":" + json(id) + ",\"_mtime\":" + str(now) + "}")
    if err != "" { return }
    st2, _, err2 := bkn_req("DELETE", "/v1/store/m365/tasks/" + id, "")
    // 404 means the record is already gone — the delete is done
    if err2 != "" && st2 != 404 { return }
    keep := []Task{}
    i := 0
    while i < len(g_tasks) {
        if g_tasks[i].id != id { keep = append(keep, g_tasks[i]) }
        i = i + 1
    }
    g_tasks = keep
}

// --- sqlite fallback ----------------------------------------------------

func db_path() {
    p := env("MDK_TASKS_DB")
    if p != "" { return p }
    h := env("MACHIN_365_HOME")
    if h != "" { return h + "/data/tasks/tasks.db" }
    return env("HOME") + "/.local/share/mdk-tasks/tasks.db"
}

func dir_of(p) {
    i := len(p)
    while i > 0 {
        i = i - 1
        if substr(p, i, i + 1) == "/" { return substr(p, 0, i) }
    }
    return "."
}

var g_db = 0

func db() {
    if g_db != 0 { return g_db }
    p := db_path()
    system("mkdir -p '" + dir_of(p) + "'")
    g_db = sqlite_open(p)
    if g_db == 0 { return 0 }
    sqlite_exec(g_db, "CREATE TABLE IF NOT EXISTS tasks (id INTEGER PRIMARY KEY, title TEXT NOT NULL, done INTEGER NOT NULL DEFAULT 0, created INTEGER NOT NULL)")
    sqlite_exec(g_db, "CREATE INDEX IF NOT EXISTS tasks_done ON tasks(done, created)")
    return g_db
}

func sql_refresh() {
    g_tasks = []Task{}
    d := db()
    if d == 0 { return }
    rows := sqlite_query(d, "SELECT id, title, done, created FROM tasks ORDER BY done ASC, created DESC")
    if rows == "" || rows == "[]" { return }
    i := 0
    while true {
        r, e := json_get(rows, "[" + str(i) + "]")
        if e != "" { break }
        g_tasks = append(g_tasks, Task{id: str(jint(r, ".id")),
            title: jstr(r, ".title"), done: jint(r, ".done"),
            created: jint(r, ".created")})
        i = i + 1
    }
}

func sql_add(title, now) {
    d := db()
    if d == 0 { return }
    sqlite_exec(d, "INSERT INTO tasks (title, done, created) VALUES (?, 0, ?)", []string{title, str(now)})
    sql_refresh()
}

func sql_set_done(id, nd) {
    d := db()
    if d == 0 { return }
    sqlite_exec(d, "UPDATE tasks SET done = ? WHERE id = ?", []string{str(nd), id})
    sql_refresh()
}

func sql_del(id) {
    d := db()
    if d == 0 { return }
    sqlite_exec(d, "DELETE FROM tasks WHERE id = ?", []string{id})
    sql_refresh()
}

// push every sqlite task into bkn (bkn assigns fresh ids); false if any
// write fails — the caller stays on sqlite rather than split the data
func sql_migrate_to_bkn() (ok) {
    ok = true
    d := db()
    if d == 0 { return ok }
    rows := sqlite_query(d, "SELECT title, done, created FROM tasks")
    if rows == "[]" { return ok }
    if rows == "" { return false }
    i := 0
    while true {
        r, e := json_get(rows, "[" + str(i) + "]")
        if e != "" { break }
        body := "{\"title\":" + json(jstr(r, ".title")) +
            ",\"done\":" + str(jint(r, ".done")) +
            ",\"created\":" + str(jint(r, ".created")) +
            ",\"_mtime\":" + str(now_ms()) + "}"
        _, _, err := bkn_req("POST", "/v1/store/m365/tasks", body)
        if err != "" { return false }
        i = i + 1
    }
    return ok
}

// bkn may have been down when probe() picked sqlite: re-check every 60s
// and, once it answers, fold pending local tasks into it and switch —
// the fallback never becomes a silent second source of truth
func bkn_maybe_takeover() {
    if g_backend != 2 || g_backend_forced != 0 { return }
    if now_ms() - g_reprobe_at < 60000 { return }
    g_reprobe_at = now_ms()
    u := bkn_endpoint()
    if u == "" { return }
    st, _, _ := http_get(u + "/_health")
    if st != 200 { return }
    if !sql_migrate_to_bkn() { return }
    g_backend = 1
    bkn_refresh()
}

// reason the last bkn call failed, for the UI badge; "" when healthy or
// when the failure is older than ~30s (ongoing failures keep refreshing
// the timestamp, so a dead backend stays flagged)
func sync_error() (s) {
    s = ""
    if g_bkn_err == "" { return s }
    if now_ms() - g_bkn_err_at > 30000 { return s }
    return g_bkn_err
}

// --- public API (used by app.src) ---------------------------------------

func task_list() (ts) {
    probe()
    if g_backend == 1 {
        if now_ms() - g_poll > 5000 {
            bkn_refresh()
            g_poll = now_ms()
        }
        return g_tasks
    }
    if now_ms() - g_poll > 1000 {
        sql_refresh()
        g_poll = now_ms()
        bkn_maybe_takeover()
    }
    return g_tasks
}

// returns 1 when the task was stored; 0 means the write failed (bkn down
// or rejected) — the caller keeps the draft and sync_error() says why
func add_task(title) (ok) {
    ok = 0
    t := trim(title)
    if t == "" { return ok }
    probe()
    now := now_ms()
    if g_backend == 1 {
        ok = bkn_add(t, now)
    } else {
        sql_add(t, now)
        ok = 1
    }
    return ok
}

func toggle_task(id) {
    probe()
    if g_backend == 1 {
        i := 0
        while i < len(g_tasks) {
            if g_tasks[i].id == id {
                bkn_set_done(id, 1 - g_tasks[i].done, now_ms())
                return
            }
            i = i + 1
        }
        return
    }
    i := 0
    while i < len(g_tasks) {
        if g_tasks[i].id == id {
            sql_set_done(id, 1 - g_tasks[i].done)
            return
        }
        i = i + 1
    }
}

func delete_task(id) {
    probe()
    if g_backend == 1 {
        bkn_del(id)
    } else {
        sql_del(id)
    }
}
